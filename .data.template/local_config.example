# Axiara local configuration
# Per-user private settings. .data/local_config/ is NOT committed, NOT synced.
# Normally generated by scripts/init-data.sh — edit this file directly if you prefer.

[data_repo]
# Team shared data repository, synced by the Agent into .data/store/ (git).
# Leave empty to skip auto-pull.
url =
branch = main

[git]
# Identity used for commits inside this workspace
user_name =
user_email =

[app]
# Interface / output language: en | zh-CN | zh-TW | ja | ko | de | fr | es | pt-BR | ru
language = en
# Sync mode: none (personal) | git (text+Git, CSV) | sql (SQL server)
sync_mode = none
# Backend: sqlite | csv | mysql | mariadb | postgresql
# (git mode → csv; Agent auto-maintains a local SQLite cache, no need to configure)
backend = sqlite
# Data source: local_file | team_repo | none
data_source = none

[storage]
# Connection string — only used when sync_mode = sql
# e.g. postgresql://user:pass@host:5432/db  |  mysql://user:pass@host:3306/db
db_dsn =
