# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments (uv / venv)
.venv/
venv/
env/

# uv
.uv/
# uv.lock IS committed (reproducible builds, CI cache matching for setup-uv)

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# FastAPI / app runtime
*.log
logs/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Local configuration / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Data & cache
data/cache/
data/tmp/

# Agent workspace runtime (never pushed)
.workbuddy/

# Axiara runtime data (never committed; the skeleton lives in .data.template/)
.data/

# Runtime outputs (generated reports/artifacts — never committed)
output/*.json
output/*.html
!output/.gitkeep
